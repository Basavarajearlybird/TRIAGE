# Copy to .env and fill in the keys you have. A provider with no key is skipped
# and its models resolve to the offline mock, which is not a measurement.

# OpenAI: the paid lane (gpt-4o-mini, gpt-4o, gpt-5-mini, gpt-5). Returns token
# logprobs, so the uncertainty signal is free from the main pass.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# NVIDIA NIM: the free lane (Llama, Nemotron). Free key at https://build.nvidia.com
# Rate limited to roughly 40 requests/minute; the benchmark scripts back off.
nvidia=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Groq: alternate host for the Llama models when NVIDIA is unavailable.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenRouter: opt-in lane. The `:free` models allow roughly 50 requests/day, so
# they are usable for a single run, not for a benchmark sweep.
openrouter=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Force every model onto the mock provider (offline smoke run).
TRIAGE_FORCE_MOCK=0
